# Copy to ".env" and fill in (never commit .env — it is gitignored).
GEMINI_API_KEY=
# OpenAI key for CHAT_PROVIDER=openai
# OPENAI_API_KEY=
# Optional OpenAI chat model (default gpt-4.1-mini)
# OPENAI_MODEL=gpt-4.1-mini
# OpenAI resiliency controls
# OPENAI_RETRY_ATTEMPTS=3
# OPENAI_TIMEOUT_MS=45000
# --- Paywall / anti-bypass security ---
# KUNDALI_TIME_ROUND_MINUTES=5
# DAILY_NEW_PROFILES_PER_IP=3
# FREE_CHAT_LIMIT=3
# CHAT_BURST_LIMIT_PER_MIN=20
# PAYWALL_REQUIRE_SESSION=true
# PAYWALL_SESSION_TTL_SEC=2592000
# PAYWALL_SESSION_SECRET=change_me
# SECURITY_CHALLENGE_SCORE_THRESHOLD=4
# SECURITY_CHALLENGE_TOKEN=
# ADMIN_SECURITY_KEY=
# SECURITY_STORE_MODE=memory
# SECURITY_STORE_MODE=vercel
# SECURITY_STORE_MODE=redis
# REDIS_URL=redis://localhost:6379
# Chat provider: gemini = Gemini only. Any other value (local, openai, hybrid) uses OpenAI when OPENAI_API_KEY is set; otherwise local chart fallback or Gemini if CHAT_PROVIDER=hybrid|gemini with a Gemini key.
# CHAT_PROVIDER=local
# Optional (default is gemini-2.0-flash). Do not use gemini-1.5-flash — Google returns 404 for many keys.
# GEMINI_MODEL=gemini-2.5-flash
# Slim JSON for greetings only — fewer tokens against free-tier limits (default on). Full chart still used for chat.
# GEMINI_GREETING_SLIM=false
# Skip Gemini entirely for greeting — always use chart-based text (uses no API quota).
# GEMINI_OFFLINE_GREETING_ONLY=true
# Set to true to surface raw Gemini errors instead of friendly quota fallbacks (default false).
# GEMINI_DISABLE_QUOTA_FALLBACK=true
# Set to false to disable local intent-aware chart replies when Gemini quota is blocked.
# GEMINI_LOCAL_INTENT_FALLBACK=false
# No Gemini HTTP calls — test chart, wheel, and chat UI without Google quota or an API key.
# GEMINI_OFFLINE_AI=true

# --- Production chat controls ---
# Max chat requests per user per window.
# CHAT_RATE_LIMIT_MAX_REQUESTS=8
# CHAT_RATE_LIMIT_WINDOW_MS=60000
# In-memory reply cache (same chart + same normalized question).
# CHAT_CACHE_TTL_MS=300000
# CHAT_CACHE_MAX_ITEMS=500
# Gemini work queue to smooth spikes.
# GEMINI_QUEUE_CONCURRENCY=2
# GEMINI_QUEUE_MAX_SIZE=100
# GEMINI_QUEUE_WAIT_TIMEOUT_MS=25000
# Gemini payload shaping.
# GEMINI_REPLY_RETRY_ATTEMPTS=4
# GEMINI_CHAT_HISTORY_TURNS=6
# GEMINI_CHAT_HISTORY_CHARS=420
# GEMINI_MAX_OUTPUT_TOKENS=768
# Dev / internal: return full chart JSON (nakṣatra, degrees, aspects, dense timing). Default off for public free tier.
# GRAHAPATH_PUBLIC_DEEP_DATA=true

# --- Supabase MVP database (optional, recommended for production) ---
# SUPABASE_URL=https://your-project-id.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# --- Feedback email notifications (optional) ---
# Feedback still saves locally even if SMTP is not configured.
# FEEDBACK_NOTIFY_EMAIL=radheradhe742@proton.me
# FEEDBACK_FROM_EMAIL=radheradhe742@proton.me
# FEEDBACK_SUBJECT_PREFIX=[GrahaPath Feedback]
# FEEDBACK_SMTP_HOST=smtp.protonmail.ch
# FEEDBACK_SMTP_PORT=587
# FEEDBACK_SMTP_SECURE=false
# FEEDBACK_SMTP_USER=your_smtp_username
# FEEDBACK_SMTP_PASS=your_smtp_password
# Free fallback: forward feedback to Formspree (emails you without SMTP setup).
# Example: FEEDBACK_FORMSPREE_ENDPOINT=https://formspree.io/f/xxxxxx
# FEEDBACK_FORMSPREE_ENDPOINT=

# --- Lemon Squeezy payments ---
# LEMON_SQUEEZY_API_KEY=
# LEMON_SQUEEZY_STORE_ID=
# LEMON_SQUEEZY_VARIANT_QUICK=
# LEMON_SQUEEZY_VARIANT_FULL=
# LEMON_SQUEEZY_WEBHOOK_SECRET=
# Optional redirects from Lemon checkout
# LEMON_SQUEEZY_SUCCESS_URL=http://localhost:5173/
# LEMON_SQUEEZY_CANCEL_URL=http://localhost:5173/

# --- Gumroad payments (fallback for unsupported Lemon regions) ---
# GUMROAD_PRODUCT_URL_QUICK=https://yourname.gumroad.com/l/quick-direction
# GUMROAD_PRODUCT_URL_FULL=https://yourname.gumroad.com/l/full-life-decode
# GUMROAD_WEBHOOK_SECRET=your_gumroad_webhook_secret
# Optional plan mapping hardening (recommended):
# GUMROAD_PRODUCT_PERMALINK_QUICK=quick-direction
# GUMROAD_PRODUCT_PERMALINK_FULL=full-life-decode
# GUMROAD_PRODUCT_ID_QUICK=
# GUMROAD_PRODUCT_ID_FULL=
