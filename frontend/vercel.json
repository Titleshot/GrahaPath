{
  "functions": {
    "api/chart-pdf.js": {
      "maxDuration": 60,
      "includeFiles": "api/_lib/**"
    }
  },
  "rewrites": [
    {
      "source": "/api/((?!chart-pdf$).*)",
      "destination": "https://grahapath-api.onrender.com/api/$1"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
