# Built into the Vercel/production bundle at build time.
# Production API origin (no trailing slash). Omit in local dev (Vite proxies /api).
# Optional if vercel.json proxies /api to Render (recommended). Otherwise set at Vercel build time:
# VITE_API_BASE_URL=https://grahapath-api.onrender.com
# Google Analytics 4 measurement id (optional)
# VITE_GA_MEASUREMENT_ID=G-XXXXXXXXXX
